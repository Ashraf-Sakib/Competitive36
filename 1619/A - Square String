#include <bits/stdc++.h>
using namespace std;
bool isSquare(string &s)
{
    if (s.length() % 2 != 0)
    {
        return false;
    }
    int mid = s.length() / 2;
    for (int i = 0; i < mid; i++)
    {
        if (s[i] != s[mid + i])
        {
            return false;
        }
    }
    return true;
}
int main()
{
 
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    // Write your code here
    int t;
    cin >> t;
    while (t--)
    {
        string str;
        cin >> str;
        if (isSquare(str))
        {
            cout << "YES" << endl;
        }
        else
        {
            cout << "NO" << endl;
        }
    }
    return 0;
}