#include <bits/stdc++.h>
using namespace std;
typedef pair<int, int> pii;
const int N = 1e5 + 3;
const long long INF = 1e18;
vector<pii> adj[N];
bool visited[N];
vector<long long> dist(N, INF);
int parent[N];
 
void dijkstra(int s)
{
    priority_queue<pii, vector<pii>, greater<pii>> pq;
    dist[s] = 0;
    parent[s] = -1;
    pq.push({dist[s], s});
    while (!pq.empty())
    {
        int u = pq.top().second;
        pq.pop();
        visited[u] = true;
        for (pii vpair : adj[u])
        {
            int v = vpair.first;
            int w = vpair.second;
            if (visited[v])
                continue;
            if (dist[v] > dist[u] + w)
            {
                dist[v] = dist[u] + w;
                pq.push({dist[v], v});
                parent[v] = u;
            }
        }
    }
}
 
int main()
{
    int n, m;
    cin >> n >> m;
    while (m--)
    {
        int u, v, w;
        cin >> u >> v >> w;
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }
 
    dijkstra(1);
 
    if (dist[n] == INF)
    {
        cout << "-1" << endl; 
    }
    else
    {
        vector<int> path;
        int current = n;
        while (current != -1)
        {
            path.push_back(current);
            current = parent[current];
        }
        reverse(path.begin(), path.end());
        for (int node : path)
        {
            cout << node << " ";
        }
    }
 
    return 0;
}