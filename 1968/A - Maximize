#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin >> t;
    while (t--) {
        int x;
        cin >> x;
        int bestY = 1, bestVal = -1;
        for (int y = 1; y < x; y++) {
            int val = __gcd(x, y) + y;
            if (val > bestVal) {
                bestVal = val;
                bestY = y;
            }
        }
        cout << bestY << "
";
    }
    return 0;
}