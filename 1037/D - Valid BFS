#include <bits/stdc++.h>
using namespace std;
 
const int N = 2e5 + 4;
vector<int> adj[N];
bool visited[N];
int level[N];
int parent[N];
vector<int> path;
 
void bfs(int s)
{
    queue<int> q;
    q.push(s);
    visited[s] = true;
    level[s] = 0;
    parent[s] = -1;
 
    while (!q.empty())
    {
        int u = q.front();
        q.pop();
        path.push_back(u);
        for (int v : adj[u])
        {
            if (!visited[v])
            {
                q.push(v);
                visited[v] = true;
                level[v] = level[u] + 1;
                parent[v] = u;
            }
        }
    }
}
 
int main()
{
    int n;
    cin >> n;
    bool flag = true;
    vector<int> arr(n);
    vector<int> sortedAdj(n);
 
    for (int i = 1; i <= n - 1; i++)
    {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }
 
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
 
    for (int i = 0; i < n; i++)
    {
        sortedAdj[arr[i] - 1] = i + 1;
    }
 
    for (int i = 1; i <= n; i++)
    {
        sort(adj[i].begin(), adj[i].end(), [&](int u, int v)
             { return sortedAdj[u - 1] < sortedAdj[v - 1]; });
    }
 
    bfs(1);
 
    if (path != arr)
    {
        flag = false;
    }
 
    if (flag)
    {
        cout << "Yes" << endl;
    }
    else
    {
        cout << "No" << endl;
    }
 
    return 0;
}