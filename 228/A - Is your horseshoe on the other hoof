#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
 
int main()
{
 
   long long s[4],c=0;
   for(int i=0;i<4;i++)
   {
    scanf("%llu",&s[i]);
   }
   for(int i=0;i<3;i++)
   {
    for(int j=0;j<3-i;j++)
    {
        if(s[j]>s[j+1])
        {
            long long temp;
            temp=s[j];
            s[j]=s[j+1];
            s[j+1]=temp;
        }
    }
   }
   for(int i=0;i<3;i++)
   {
       if(s[i]==s[i+1])
        c++;
   }
   printf("%llu
",c);
 
    return 0;
}