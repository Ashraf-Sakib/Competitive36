#include <iostream>
#include <string>
 
std::string isLuckyTicket(const std::string& ticket) {
    int sumFirstThree = (ticket[0] - '0') + (ticket[1] - '0') + (ticket[2] - '0');
    int sumLastThree = (ticket[3] - '0') + (ticket[4] - '0') + (ticket[5] - '0');
 
    if (sumFirstThree == sumLastThree) {
        return "YES";
    } else {
        return "NO";
    }
}
 
int main() {
    int t;
    std::cin >> t;
 
    for (int i = 0; i < t; ++i) {
        std::string ticket;
 
        std::cin >> ticket;
 
        std::string result = isLuckyTicket(ticket);
        std::cout << result << std::endl;
    }
 
    return 0;
}